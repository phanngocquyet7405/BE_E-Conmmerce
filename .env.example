# ===================================================================
# MÔI TRƯỜNG & CỔNG CHẠY
# ===================================================================
# Profile kích hoạt: dev hoặc prod
SPRING_PROFILES_ACTIVE=dev
# Cổng lắng nghe của ứng dụng
PORT=8080

# ===================================================================
# CƠ SỞ DỮ LIỆU MONGODB
# ===================================================================
# Chuỗi kết nối MongoDB (Local hoặc MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/ecommerce_dev_db

# ===================================================================
# CẤU HÌNH REDIS
# ===================================================================
# URL kết nối Redis đầy đủ (dành cho Upstash hoặc Redis Cloud có auth/ssl, ví dụ rediss://default:pass@host:port)
REDIS_URL=
# Redis Host chạy local hoặc container
REDIS_HOST=localhost
# Redis Port
REDIS_PORT=6379
# Mật khẩu Redis (để trống nếu không bật auth)
REDIS_PASSWORD=change-me
# Bật SSL nếu kết nối Redis qua Internet (ví dụ Upstash dùng true, local dùng false)
REDIS_SSL_ENABLED=false

# ===================================================================
# BẢO MẬT JWT (Chuỗi Base64 >= 256-bit / 32 bytes)
# Sinh khóa ngẫu nhiên trên Linux/macOS/Git Bash bằng: openssl rand -base64 32
# ===================================================================
# Khóa ký Access Token (sinh bằng: openssl rand -base64 32)
JWT_ACCESS_SECRET=change-me-base64-secret-min-32-bytes-long=
# Khóa ký Refresh Token (sinh bằng: openssl rand -base64 32)
JWT_REFRESH_SECRET=change-me-base64-secret-min-32-bytes-long=
# Thời gian sống Access Token tính bằng mili-giây (3600000 = 1 giờ)
JWT_ACCESS_EXPIRATION_MS=3600000
# Thời gian sống Refresh Token tính bằng mili-giây (604800000 = 7 ngày)
JWT_REFRESH_EXPIRATION_MS=604800000

# ===================================================================
# CẤU HÌNH GỬI MAIL OTP (GMAIL SMTP)
# ===================================================================
# Địa chỉ Gmail người gửi (dùng gửi mã OTP xác thực đăng ký)
SPRING_MAIL_USERNAME=your_email@gmail.com
# Mật khẩu ứng dụng 16 ký tự của Gmail (Google Account -> Security -> 2-Step Verification -> App passwords)
SPRING_MAIL_PASSWORD=change-me-app-password

# ===================================================================
# CỔNG THANH TOÁN SEPAY (VIETQR + WEBHOOK)
# ===================================================================
# Mã định danh ngân hàng SePay (ví dụ: MBBank, VCB, ACB, TPBank)
SEPAY_BANK_ID=MBBank
# Số tài khoản ngân hàng nhận tiền
SEPAY_BANK_ACCOUNT=0123456789
# Khóa bí mật Webhook HMAC-SHA256 (lấy từ trang Webhooks của SePay -> Cấu hình Webhook -> Bước Bảo mật)
SEPAY_WEBHOOK_SECRET=change-me-sepay-webhook-secret

# ===================================================================
# LƯU TRỮ ẢNH CLOUDINARY
# ===================================================================
# Cloud Name tài khoản Cloudinary
CLOUDINARY_CLOUD_NAME=change-me
# API Key Cloudinary
CLOUDINARY_API_KEY=change-me
# API Secret Cloudinary
CLOUDINARY_API_SECRET=change-me

# ===================================================================
# CẤU HÌNH CORS
# ===================================================================
# Danh sách domain frontend được phép truy cập (phân tách bởi dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
