SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ===================================================================
# 1. CẤU HÌNH CƠ SỞ DỮ LIỆU MONGODB ATLAS
# ===================================================================
# Khi có link MongoDB Atlas chính thức từ cụm của bạn, hãy thay vào dòng dưới:
# Cú pháp mẫu: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
# Mặc định đang để link placeholder, hệ thống sẽ tự động fallback về localhost:27017 nếu chưa có internet
MONGODB_URI=mongodb+srv://student_dev:DemoPassword123@cluster0.abcde.mongodb.net/ecommerce_db?retryWrites=true&w=majority

# ===================================================================
# 2. CẤU HÌNH REDIS (Quản lý Token Whitelist/Blacklist & Cache)
# ===================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================================================================
# 3. CẤU HÌNH KHÓA BẢO MẬT JWT (Đã cấu hình sẵn chuỗi Base64 >= 256-bit)
# ===================================================================
# Bạn có thể dùng luôn chuỗi mẫu này để test ngay, hoặc đổi thành secret riêng khi triển khai Production
JWT_ACCESS_SECRET=bXktc3VwZXItc2VjcmV0LWaccessLtleS1mb3ItZWNvbW1lcmNlLTIwMjYtYmFja2VuZA==
JWT_REFRESH_SECRET=bXktc3VwZXItc2VjcmV0LXJlZnJlc2gta2V5LWZvci1lY29tbWVyY2UtMjAyNi1iYWNrZW5k
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===================================================================
# 4. CẤU HÌNH CORS CHO FRONTEND & MOBILE
# ===================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
